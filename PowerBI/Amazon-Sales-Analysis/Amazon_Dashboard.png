explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"123059715\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"3533083032\":{\"name\":\"3533083032\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"834015471\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"460249292\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3676183697\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":217,\"value\":{\"web-enable-for-new-users\":false,\"homepage_prompt_style\":\"list\",\"chatgpt_web_home_page_starter_prompts_anon_v2\":true,\"chatgpt_android_starter_prompts_use_case\":false,\"web-enable-for-utm-campaign-existing-users\":false,\"web-enable-for-ad-group-existing-users\":false,\"prompt_ui_style\":\"\",\"is_ad_group_prompt_enabled\":false,\"web-enable-for-utm-campaign-new-users\":false,\"trending_prompt_countries\":[],\"web_enable_for_existing_users\":false,\"chatgpt_android_home_page_starter_prompts_anon_v2\":false,\"use_baseline_prompts\":false,\"web-enable-for-ad-group-new-users\":false,\"should_show_greeting\":false,\"hardcoded_prompt_countries\":[\"IN\"],\"is_trending_prompts_enabled_android\":false,\"is_trending_prompts_enabled_web\":false},\"id_type\":\"stableID\",\"is_device_based\":true,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"834015471\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"460249292\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3676183697\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"2765362629\":{\"name\":\"2765362629\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":2,\"value\":{\"show_inline_share_button\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"868657095\":{\"name\":\"868657095\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1657580268\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":12,\"value\":{\"custom_instructions_length\":1500},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"1657580268\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"1702227128\":{\"name\":\"1702227128\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"value\":{\"copy_variant\":\"claim_offer\",\"icon_type\":\"gift\",\"show_free_upsell\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"3790286987\":{\"name\":\"3790286987\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3014785993\",\"gateValue\":\"false\",\"ruleID\":\"6AjlvwkLIOyemxVdYK0rtl\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3720285278\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":3,\"value\":{\"show_share_text\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"3014785993\",\"gateValue\":\"false\",\"ruleID\":\"6AjlvwkLIOyemxVdYK0rtl\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3720285278\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"942000299\":{\"name\":\"942000299\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"value\":{\"codex_sidebar_button_behavior_variant\":\"control\"},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"3732549458\":{\"name\":\"3732549458\",\"rule_id\":\"5RzAYujloSIrrx99dmqdOt\",\"secondary_exposures\":[{\"gate\":\"790117001\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2067628123\",\"gateValue\":\"false\",\"ruleID\":\"3CuBjEMi97tY3EGnq0NA9s\"},{\"gate\":\"1237525916\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3879460227\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"213562696\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1108389362\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2691265090\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"335468445\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3442178281\",\"gateValue\":\"true\",\"ruleID\":\"3lL0brFcX98DIYGN5gIeLL:100.00:1\"}],\"version\":669,\"value\":{\"share_button_enabled\":false,\"enable_preview_v2_ios\":true,\"is_holdout\":false,\"fast_model_prefetch_guaranteed_prefetch_budget_seconds\":0.35,\"enable_learning_block_v4\":false,\"enable_learning_block_groups\":true,\"enable_graphable_function_v2_renderer\":false,\"enable_learning_block_groups_with_graphable_regex\":false,\"language_learning_block_widget_config\":{\"enabled\":true,\"pronunciation\":{\"max_source_characters\":5000,\"parameter_descriptions\":{\"contract_heading\":\"PRONUNCIATION PARAMETER CONTRACT\",\"pronunciation_hint\":\"pronunciation_hint: Give one complete canonical pronunciation for exactly source_text in pronunciation_language. For a short direct 'how do you say X in Y' request, the hint must pronounce the generated target-language expression and must never pronounce the source-language phrase. Honor an explicit user-requested notation before every default: if the user asks for IPA, the visible hint must be IPA, not Pinyin, romanization, or respelling. Otherwise emit exactly one learner-facing notation system: use tone-marked Hanyu Pinyin for Mandarin Chinese (for example, 你好 → nǐ hǎo); Jyutping with tone digits for Cantonese (for example, 你好 → nei5 hou2); Hepburn-style romaji with macrons where needed for Japanese (for example, ありがとう → arigatō); and Revised Romanization for Korean (for example, 감사합니다 → gamsahamnida). For every other language, the visible hint MUST be exactly one accurate IPA transcription enclosed in /slashes/; it is never an English-like syllable spelling, mnemonic respelling, or mixed notation. For example, Spanish desayuno may be /de.saˈʝu.no/ with dialect-appropriate IPA, never deh-sah-YOO-no. IPA represents the actual surface pronunciation with obligatory phonology rather than spelling: for an explicit Mandarin IPA request, 你好 uses third-tone sandhi on the first syllable, approximately /ni˧˥ xɑʊ̯˨˩˦/, while ordinary default Pinyin remains nǐ hǎo; standard French inhabituel is /i.na.bi.tɥɛl/, not a nasal initial /ɛ̃.../ and not /...ty.ɛl/. Never default to IPA for the four named learner systems, use Mandarin Pinyin for Cantonese, omit Sinitic tone marks or digits, mix two notation systems in one hint, or use rough-English respelling as the primary hint. Include pronunciation notation only—no meaning, gloss, explanation, alternative, or placeholder.\",\"pronunciation_language\":\"pronunciation_language: Required BCP-47 playback locale for source_text. For a short direct 'how do you say X in Y' request, use language Y, because source_text is the generated Y-language expression. For ordinary requests, choose the language and locale of the requested utterance, not the instruction language or name origin. If one locale is not unambiguous, emit zero calls and clarify.\",\"source_text\":\"source_text: For ordinary pronunciation, use the byte-exact raw user span approved by the grounding gate. For a short direct 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' request, use the complete faithful target-language expression that answers the request; do not use the source-language phrase or the whole command. Preserve the target expression's natural script, case, punctuation, whitespace, and every token. If the target expression is ambiguous or has no reliable conventional rendering, emit zero calls and clarify.\",\"pronunciation_audio_text\":\"pronunciation_audio_text: Optional hidden playback input for exactly the same canonical reading as source_text and pronunciation_hint. Use ordinary text in pronunciation_language; never put IPA, explanations, stress marks, alternatives, or a foreign-language approximation here. Omit it when native-script source_text is already the best playback input. After a card is selected, if ambiguous or unfamiliar source_text plus locale would speak the wrong hint, use the shortest same-language literal respelling that speaks only the hint; distinct readings need distinct values (e.g. \\\"giff\\\"/\\\"jiff\\\", \\\"taow\\\"). This field cannot change playback speed. For a request to slow audio, never claim the speed changed or distort spelling; omit the card and explain the limitation unless a separate exact user-authored slower practice unit can be carded truthfully.\"},\"pronunciation_description\":\"PRONUNCIATION OUTPUT CONTRACT\\nAfter user grounding and locale are unambiguous, an explicit pronunciation request for an ordinary word or phrase should emit a card; do not suppress merely because producing IPA requires phonetic knowledge. Emit exactly one call per explicitly requested source-and-reading pair in order, or zero calls if any pair is unsafe. Each call uses the pair's byte-exact user-authored source_text, supported pronunciation_language, and one reliable canonical pronunciation_hint for that exact reading. Suppress or ask one concise clarification only when the reading genuinely depends on an unknown name, unresolved alternative, variable dialect, ambiguous language or locale, or a specific safety rule such as unmarked East-Slavic lexical stress. Optional pronunciation_audio_text must match the same reading and locale. Never reconstruct assistant or media text, mix intents, encode alternatives in one hint, or rely on fallback or alt text; source-repeating alt text is a mechanism failure, not a pronunciation result.\",\"continuation_description\":\"CONTINUATION RULES\\nUse pronunciation after an earlier result only when the newest request explicitly selects exact user-authored text and its reading or locale, and that span still occurs exactly once across all visible user text under newline-equivalent grounding. New bare user text becomes the new source. If a deictic request selects only assistant-rendered text, emit zero cards and answer normally or ask the user to paste it. Ignore unrelated requests and opt-outs.\",\"routing_description\":\"ROUTING RULES\\nAfter safety prerequisites pass, use pronunciation when the primary goal is to hear, learn, sound out, romanize, transliterate, or practice an exact word, phrase, sentence, or small explicit set. Also use pronunciation for a short direct say request of the form 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' (and localized equivalents): first determine the faithful target-language expression, then card that target expression with its canonical pronunciation. A whole-document rewrite, script conversion, replace-all request, spelling check, punctuation edit, or formatting-preservation workflow is a writing transformation and must not emit a pronunciation card. Use translation for other explicit requests to render visible text into a target language. The newest request controls intent, locale, notation, and grouping. Honor opt-outs and never call translation and pronunciation for the same source span.\",\"max_audio_text_characters\":5000,\"outside_prose_description\":\"OUTSIDE PROSE RULES\\nThe card exclusively owns source playback and pronunciation_hint. When a pronunciation card is shown, include one brief useful natural sentence in the user's instruction language, but never repeat the complete source, hint, IPA, transliteration, respelling, or playback text outside the card. Independently requested explanation may discuss a sound, stress, rhythm, or usage without reproducing the full notation. Add no unsupported facts or alternate reading. If no card is called, answer normally without implying that a card was suppressed or created.\",\"runtime_descriptions\":{\"follow_up_actions\":\"follow_up_actions: do not emit follow-up actions.\",\"contract_heading\":\"PRONUNCIATION RUNTIME CONTRACT\",\"pronunciation_audio_text\":\"pronunciation_audio_text: at most 5000 characters.\",\"multiple_readings\":\"multiple_readings: build the ordered set of (exact user-authored source_text, explicitly requested reading or locale) pairs. Emit one call per pair in order, including separate calls when one span has multiple requested readings. Never encode alternatives or locale labels inside one hint. A template with unresolved options is not a reading set; emit zero calls and ask the user to choose. If any pair lacks a unique grounded source, unambiguous locale, or one verified reading, emit zero calls.\",\"source_text\":\"source_text: fewer than 5000 raw characters; at 5000 or more, do not call.\",\"pronunciation_hint\":\"pronunciation_hint: at most 5000 characters and preserved as one exact string, including embedded line breaks.\"},\"max_hint_characters\":5000,\"source_selection_description\":\"SOURCE SELECTION\\nFor an ordinary pronunciation request, identify the exact complete user-authored source span requested in the newest message; after newline-equivalent uniqueness checks, copy that raw span byte-for-byte. One narrow exception applies to a short direct 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' request: source_text is the faithful target-language expression that answers the request, not the source-language words inside the command. For example, 'how do you say hello in Chinese' cards the Chinese expression 你好, never the English word hello. This exception is allowed only when the source expression, target language, and one conventional target rendering are unambiguous. Otherwise ask one concise clarification. Never reconstruct inaccessible media or attachment text.\",\"overview_description\":\"PRECEDENCE AND SAFETY\\nApply rules in this order: (1) eligibility and resolver safety, (2) intent routing, (3) exact source-and-reading selection, (4) pronunciation fidelity, then (5) outside prose. A direct request must call the matching tool only after every higher-priority prerequisite passes. Otherwise emit no language-learning call and answer normally or ask one concise clarification. Never call translation and pronunciation for the same exact source span, never call merely to expose fallback or alt text, and never claim that a card exists or survived resolution.\"},\"schema_version\":9,\"translation\":{\"continuation_description\":\"COMMAND-ONLY CONTINUATIONS AND RETRIES\\nAfter removing the operative translation command, target label, reference words, and workflow metadata from the newest turn: if substantive payload remains, stop and use it. Otherwise resolve in this order. (1) An explicit reference such as the earlier/original/above sentence, the list, all, or them selects that complete referenced artifact even when it is not adjacent; reference meaning outranks recency. (2) If the command repeats an immediately preceding translation request that was not fulfilled, skip the intervening command echo, literal command translation, refusal, or discussion and retry the same unresolved complete source and target. (3) Otherwise a bare translate/translate this/in \u003clanguage\u003e selects the complete immediately preceding substantive assistant artifact when it was not merely a response to that same translation command. (4) A plural reference selects the complete finite set, not a subset. A meta detour to analyze, acknowledge, or record workflow rules is context, not source, when the latest request then asks to translate the earlier/original text. Stop at the first unambiguous match.\\nWORKED DECISIONS\\n- Established translation workflow; user supplies a new short phrase without a command: translate that new phrase, never the prior phrase.\\n- Assistant gives a substantive explanation or draft; user says only Translate: translate the entire explanation or draft, not an older user sentence or older widget payload.\\n- User says translate into a language; assistant only echoes/translates that command; user repeats it: retry the substantive artifact from before the first command.\\n- Assistant offers several reply options; user says translate them/all: translate every distinct offered option in one complete ordered card.\\n- A translation task detours through analysis of a mistake; user says remember that and translate the earlier/original sentence: translate the unresolved pre-detour source, not the analysis request or analysis answer.\\\\n- In an established translation workflow, first classify the newest source-language turn by function. A bare content-like deictic utterance such as German 'Das meine ich' ('that is what I mean'), English 'that's what I mean', or Spanish 'eso quiero decir' is the newest source payload; translate that utterance and never reuse the prior source. But complaint or feedback about the assistant or prior answer is never source, even when written in the active source language or when it repeats words such as 'translate' or 'translation'; for example, a turn meaning 'why can you not follow my instructions; all I asked was translate' must not be translated or shown in a language-learning widget. Complaint/feedback precedence wins over this deictic-payload rule. Workflow instructions and opt-outs also remain non-source.\",\"max_follow_up_actions\":3,\"parameter_descriptions\":{\"follow_up_action_icon\":\"follow_up_action_icon: Optional leading icon name rendered inside the action button.\",\"follow_up_action_weight\":\"follow_up_action_weight: Relative ranking score used when callers select which actions to show.\",\"follow_up_action_label\":\"follow_up_action_label: A concise benefit-first label in the user's instruction language. The user should be able to predict the useful result before clicking. Make it specific to the visible goal and source, such as 'Make it a tighter status bullet', 'Use more natural business Japanese', 'Compare literal wording', or 'Practice the key Japanese terms'. Do not use bare generic labels such as 'Alternative', 'More concise', 'Example', 'Status-report example', or 'Pronunciation'.\",\"follow_up_actions\":\"follow_up_actions: Optional for every emitted translation card. When no genuinely useful next step exists, emit none instead of padding. Otherwise emit one to three useful, distinct, self-contained actions in the user's instruction language; prefer three only when all three add real value. Keep the same complete source and target. Choose actions from the actual source type, length, and visible user goal: for a short phrase, useful options can be a natural/formal/literal/regional retranslation or pronunciation practice for the exact translated expression; for work, email, report, or document text, useful options can be a tighter complete rendering, a more natural or audience-appropriate register already supported by context, or terminology/format-preserving refinement; for long text, do not offer low-value full-document pronunciation, and offer pronunciation only for exact selected key terms when that would genuinely help. Every visible label must advertise a concrete benefit before clicking, and every query must request a complete useful result. Never invent an audience or scenario, change source scope or target, duplicate the translation outside the card, or pad with generic, overlapping, unsupported, or low-value actions.\",\"target_language\":\"target_language: Use the destination explicitly named by the newest request. Otherwise preserve the single active destination of the unresolved retry or established translation workflow for the selected source. A command-only request following a visible artifact may use the one unambiguous destination established by that conversation. Never translate a target-language label as source and never infer from command language alone. If multiple destinations remain plausible, clarify.\",\"translated_text\":\"translated_text: One complete target-language rendering of source_text from its first unit through its last. Preserve the opening qualifier, all paragraphs, lines, headings, options, examples, numbers, and closings. For a referenced list, include every distinct offered item in the same card and order. Add no unsupported facts and omit nothing.\",\"follow_up_action_query\":\"follow_up_action_query: A fully self-contained command in the user's instruction language that can produce the promised useful result without hidden conversation context. Include the complete relevant source or exact translated expression, the target language, and the selected operation. For a retranslation, request the complete revised target-language rendering while preserving the same source meaning and scope. For pronunciation practice, identify the exact short translated expression or exact selected key terms and language; do not request vague or low-value pronunciation of an entire long document. Never rely on the label alone, invent context, change target language, narrow the source, or ask only for commentary, a diff, or an explanation when the label promises a revised translation.\",\"contract_heading\":\"TRANSLATION PARAMETER CONTRACT\",\"source_text\":\"source_text: The complete locked source selected by the continuation rules and worked decisions. A new short phrase in an established workflow is the whole newest source. A bare Translate after a substantive assistant message selects that whole message. A repeated command after a command echo retries the pre-command artifact. An earlier/original reference across a meta detour selects the unresolved pre-detour source. An all/them reference includes every distinct offered option. Copy from the first substantive character through the last, including opening qualifiers, every paragraph and every list item. Never use an older widget payload, command, command echo, analysis detour, stale source, or partial artifact. Count the complete locked source before calling: it must be fewer than 5000 raw characters and not blocked by HARD CODE GATE; at 5000 or more, emit zero calls and never truncate to fit.\"},\"routing_description\":\"TRANSLATION ROUTING\\nUse translation for an explicit cross-language request or an established translation workflow. In an established workflow, any new bare word, phrase, sentence, or document in the newest user turn is the new source even without a translation verb; it must never lose to older history. A command-only request may select a clearly referenced visible user or assistant artifact. Treat every language's semantic equivalent of translate, translation, render, in/to/into \u003clanguage\u003e, translate this/it/them/all, and Dịch as an operative command, not translatable payload. A repeated command after an answer that merely echoed, translated, or discussed the command is a retry of the unresolved earlier source, not a request to translate that answer. Do not call for pronunciation, romanization, transliteration, reading aloud, an opt-out, inaccessible media, or anything blocked by the HARD CODE GATE.\",\"max_output_characters\":100000,\"runtime_descriptions\":{\"source_text\":\"source_text: fewer than 5000 raw characters; at 5000 or more, do not call.\",\"translated_text\":\"translated_text: at most 100000 characters and complete for the selected source.\",\"contract_heading\":\"TRANSLATION RUNTIME CONTRACT\",\"follow_up_actions\":\"follow_up_actions: optional; emit zero to three valid, distinct, self-contained, source-grounded actions for a translation card; render at most max_follow_up_actions=3. Never pad the bar with a generic or low-value action.\"},\"language_options_by_language\":{\"vi\":[{\"label\":\"Vietnamese\",\"language_code\":\"vi\"}],\"ne\":[{\"language_code\":\"ne\",\"label\":\"Nepali\"}],\"ur\":[{\"language_code\":\"ur\",\"label\":\"Urdu\"}],\"fr\":[{\"label\":\"French\",\"language_code\":\"fr\"}],\"mi\":[{\"language_code\":\"mi\",\"label\":\"Maori\"}],\"de\":[{\"language_code\":\"de\",\"label\":\"German\"}],\"et\":[{\"language_code\":\"et\",\"label\":\"Estonian\"}],\"he\":[{\"language_code\":\"he\",\"label\":\"Hebrew\"}],\"it\":[{\"language_code\":\"it\",\"label\":\"Italian\"}],\"hr\":[{\"label\":\"Croatian\",\"language_code\":\"hr\"}],\"zh-Hans\":[{\"language_code\":\"zh-Hans\",\"label\":\"Simplified Chinese\"},{\"language_code\":\"zh-Hant\",\"label\":\"Traditional Chinese\"}],\"cs\":[{\"label\":\"Czech\",\"language_code\":\"cs\"}],\"nl\":[{\"language_code\":\"nl\",\"label\":\"Dutch\"}],\"fi\":[{\"language_code\":\"fi\",\"label\":\"Finnish\"}],\"bg\":[{\"language_code\":\"bg\",\"label\":\"Bulgarian\"}],\"hu\":[{\"label\":\"Hungarian\",\"language_code\":\"hu\"}],\"be\":[{\"language_code\":\"be\",\"label\":\"Belarusian\"}],\"sk\":[{\"label\":\"Slovak\",\"language_code\":\"sk\"}],\"ms\":[{\"label\":\"Malay\",\"language_code\":\"ms\"}],\"zh-TW\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-CN\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-TW\"}],\"fa\":[{\"label\":\"Persian\",\"language_code\":\"fa\"}],\"es\":[{\"label\":\"Spanish\",\"language_code\":\"es\"}],\"sw\":[{\"language_code\":\"sw\",\"label\":\"Swahili\"}],\"ar\":[{\"label\":\"Arabic\",\"language_code\":\"ar\"}],\"cy\":[{\"label\":\"Welsh\",\"language_code\":\"cy\"}],\"bs\":[{\"language_code\":\"bs\",\"label\":\"Bosnian\"}],\"tr\":[{\"label\":\"Turkish\",\"language_code\":\"tr\"}],\"az\":[{\"language_code\":\"az\",\"label\":\"Azerbaijani\"}],\"id\":[{\"label\":\"Indonesian\",\"language_code\":\"id\"}],\"sr\":[{\"label\":\"Serbian\",\"language_code\":\"sr\"}],\"lv\":[{\"label\":\"Latvian\",\"language_code\":\"lv\"}],\"pl\":[{\"label\":\"Polish\",\"language_code\":\"pl\"}],\"ru\":[{\"label\":\"Russian\",\"language_code\":\"ru\"}],\"en\":[{\"label\":\"English\",\"language_code\":\"en\"}],\"el\":[{\"language_code\":\"el\",\"label\":\"Greek\"}],\"ta\":[{\"language_code\":\"ta\",\"label\":\"Tamil\"}],\"ro\":[{\"language_code\":\"ro\",\"label\":\"Romanian\"}],\"lt\":[{\"label\":\"Lithuanian\",\"language_code\":\"lt\"}],\"ca\":[{\"label\":\"Catalan\",\"language_code\":\"ca\"}],\"ko\":[{\"label\":\"Korean\",\"language_code\":\"ko\"}],\"af\":[{\"label\":\"Afrikaans\",\"language_code\":\"af\"}],\"hy\":[{\"label\":\"Armenian\",\"language_code\":\"hy\"}],\"kn\":[{\"language_code\":\"kn\",\"label\":\"Kannada\"}],\"mk\":[{\"language_code\":\"mk\",\"label\":\"Macedonian\"}],\"da\":[{\"language_code\":\"da\",\"label\":\"Danish\"}],\"no\":[{\"label\":\"Norwegian\",\"language_code\":\"no\"}],\"th\":[{\"label\":\"Thai\",\"language_code\":\"th\"}],\"zh-CN\":[{\"language_code\":\"zh-CN\",\"label\":\"Simplified Chinese\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-TW\"}],\"zh-HK\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-CN\"},{\"language_code\":\"zh-HK\",\"label\":\"Traditional Chinese\"}],\"is\":[{\"label\":\"Icelandic\",\"language_code\":\"is\"}],\"zh-Hant\":[{\"language_code\":\"zh-Hans\",\"label\":\"Simplified Chinese\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-Hant\"}],\"sl\":[{\"language_code\":\"sl\",\"label\":\"Slovenian\"}],\"kk\":[{\"label\":\"Kazakh\",\"language_code\":\"kk\"}],\"tl\":[{\"label\":\"Tagalog\",\"language_code\":\"tl\"}],\"zh-MO\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-CN\"},{\"language_code\":\"zh-MO\",\"label\":\"Traditional Chinese\"}],\"zh-SG\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-SG\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-TW\"}],\"mr\":[{\"label\":\"Marathi\",\"language_code\":\"mr\"}],\"sv\":[{\"label\":\"Swedish\",\"language_code\":\"sv\"}],\"gl\":[{\"label\":\"Galician\",\"language_code\":\"gl\"}],\"ja\":[{\"label\":\"Japanese\",\"language_code\":\"ja\"}],\"pt\":[{\"label\":\"Portuguese\",\"language_code\":\"pt\"}],\"uk\":[{\"language_code\":\"uk\",\"label\":\"Ukrainian\"}],\"hi\":[{\"label\":\"Hindi\",\"language_code\":\"hi\"}],\"zh\":[{\"language_code\":\"zh\",\"label\":\"Simplified Chinese\"},{\"language_code\":\"zh-TW\",\"label\":\"Traditional Chinese\"}]},\"translation_description\":\"COMPLETE TRANSLATION\\nTranslate every meaning-bearing unit of the locked post-edit source exactly once and in order. Preserve the first source unit and opening qualifier, then every paragraph, actor, action, object, relation, negation, modality, aspect, scope, quantity, date, name, identifier, contrast, repetition, list item, example, heading, and closing through the final source unit. Apply the newest visible correction or requested edit, but retain all untouched material. Do not add a greeting, answer, explanation, inferred context, invented tone, or unrelated content. Audit first-to-first, last-to-last, and every intervening unit before emission. An ordinary request emits one complete translation card. A referenced list or option set is one complete source: include every distinct offered item in one card in the same order, even when one item was later recommended or repeated. Emit two or three complete cards only when the visible user request explicitly asks for alternative renderings or when the same source has materially different plausible tones and visible context cannot choose.\",\"source_selection_description\":\"SOURCE SELECTION\\nFirst classify the newest user turn without consulting history. If it is a new payload in an established translation workflow, lock the whole newest message as source even when it is short or contains ordinary pronouns such as this, that, it, or them; only a pronoun attached to a translation command acts as a reference. Otherwise apply COMMAND-ONLY CONTINUATIONS AND RETRIES. A bare translation command after a substantive assistant explanation selects that entire explanation. A repeated command after a command echo selects the unresolved pre-command artifact. An explicit earlier/original reference across a meta detour selects the unresolved artifact that preceded the detour. An all/them reference to offered options selects every distinct option; a later recommendation does not narrow the set. User and assistant artifacts are both eligible. Historical widget payloads and older translation pairs never override the selected newer artifact. Once selected, lock from the first substantive character of the artifact through the last: include opening qualifiers, all paragraphs, headings, list items, examples, numbers, closings, and emojis. Never select the command, its literal translation, an acknowledgment, an analysis detour, a stale example, or a narrower excerpt. For edit-then-translate, apply only explicit edits after the boundary lock. At 5000 or more raw characters, ambiguity, or a HARD CODE GATE match, emit no card.\",\"max_source_characters\":5000,\"outside_prose_description\":\"OUTSIDE PROSE\\nThe translation card exclusively owns the standalone source-to-translation answer. Preserve useful request-proportional information that a high-quality answer without the widget would provide, such as register, nuance, literal composition, word or character breakdowns, grammar, regional usage, common alternatives, or grounded examples. Never add an introductory or concluding sentence whose only purpose is to restate '\u003csource\u003e in \u003ctarget language\u003e is \u003ctranslated_text\u003e', and never quote or reproduce the complete translated_text as a second standalone answer outside the card. It is valid to reference individual translated words or characters when they are necessary for a genuine explanation, and valid to use the expression naturally inside a grounded example. If no useful nonredundant information exists, emit no outside prose. If no card is emitted, answer normally with the full appropriate information.\",\"overview_description\":\"AUTHORITATIVE TRANSLATION PROCEDURE\\nUse this single ordered procedure; no later field may add another source search or eligibility exception. (0) Emit no translation call for named-language content creation or for identifying, comparing, or explaining named-language terms or usage unless the user also explicitly requests source-to-target translation, which then follows existing routing. (1) Apply the HARD CODE GATE: if the requested artifact contains executable or machine-readable SQL, source code, JSON, XML, HTML tags, configuration, shell commands, or similar syntax-sensitive literals, emit no language-learning call even when prose surrounds the syntax or the user asks to translate while preserving it; use the ordinary code/writing surface. Human-readable prose is still eligible when it merely contains technical terms, names, numbers, links, or Markdown presentation. (2) Classify the newest turn as new source payload, command-only continuation, retry, or explicit reference. Translation commands, language labels, deictic words, and workflow instructions are never source. (3) Lock one complete artifact with SOURCE SELECTION. (4) Apply only explicit visible edits. (5) Lock the target. (6) Translate every unit and emit the complete result. If source or target remains genuinely ambiguous, ask one concise clarification. Never emit translation and pronunciation for the same source span.\"},\"version\":\"trigger_v342\"},\"enable_genui\":false,\"enable_genui_with_common_keywords\":false,\"enable_math_block_always_prefetch_v3\":false,\"enable_explicit_type_id\":false,\"ios_inline_preview_app_block_style_enabled\":false,\"enable_image_grid_override\":false,\"enable_multiple_choice_interactivity_v2\":false,\"enable_learning_block_staging_groups\":false,\"enable_graphable_function_v2\":false,\"enable_pronunciation_block_v4_audio_fix_v2_realtime_audio_mini\":false,\"fast_model_prefetch_use_sheep_backend\":true,\"enable_math_block_always_prefetch_variant\":false,\"enable_multiple_choice_interactivity\":false,\"enable_math_block_always_prefetch_v2\":false,\"enable_latex_content_reference_override\":false,\"enable_math_block_always_prefetch_v4\":false,\"enable_fast_model_prefetch\":\"default\",\"enable_conversation_audio_summary\":false,\"enable_preview_with_thumbnail\":true,\"enable_learning_block_graphable_split_groups\":false,\"enable_learning_block_v3\":false,\"enable_preview_v2_android\":true,\"enable_learning_block_v4_groups\":false,\"enable_learning_block_parameterized_groups\":false,\"enable_pronunciation_block_v4_audio_fix_v2\":false,\"graphable_function_v2_parameterized\":false,\"enable_learning_quiz_widget\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"94228759\",\"explicit_parameters\":[\"language_learning_block_widget_config\",\"enable_pronunciation_block_v4_audio_fix_v2\"],\"undelegated_secondary_exposures\":[{\"gate\":\"790117001\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2067628123\",\"gateValue\":\"false\",\"ruleID\":\"3CuBjEMi97tY3EGnq0NA9s\"},{\"gate\":\"1237525916\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3879460227\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"213562696\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1108389362\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2691265090\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"335468445\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"4266965298\":{\"name\":\"4266965298\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":40,\"value\":{\"preamble_format_preset_id\":\"\",\"late_ads_visibility_gate_enabled\":false,\"consent_modal_variant\":\"\",\"keepalive_event_logger_web\":false,\"android_display_zoom_scale_threshold\":0,\"consent_modal_enabled\":false,\"ask_chatgpt_button_copy_key\":\"ASK_CHATGPT\",\"feedback_interested_enabled\":false,\"consent_modal_pre_selected\":true,\"ask_about_ad_ephemeral_thread_panel\":false,\"show_ask_chatgpt_menu_item\":true,\"consent_modal_title\":\"Make ads relevant for you\",\"late_ads_event_discard_timeout_seconds\":5,\"consent_modal_short_copy\":true,\"show_ask_chatgpt_button\":false,\"late_ads_event_discard_timeout_afte